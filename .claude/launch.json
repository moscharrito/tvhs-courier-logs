{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "server"],
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "web"],
      "port": 5173
    },
    {
      "name": "server-built",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start", "-w", "server"],
      "port": 3000
    },
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "./app", "run", "start"],
      "port": 8081
    }
  ]
}
