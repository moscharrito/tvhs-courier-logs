node_modules/
dist/
*.log
.DS_Store

# Local databases and secrets live under server/ (see server/.gitignore)

# Basic-auth credential for the ttyd terminal in .claude/launch.json. It is
# generated on first run and must never be committed: launch.json is tracked,
# which is exactly why the secret lives in its own file and not in there.
.claude/ttyd-credential
backups/

# Points the app at a server. Local choice, not a shared one.
app/.env

# Where somebody redirects a credential-printing script.
#
# create:portals, create-leads and seed:demo-uh each generate passwords and
# print them ONCE, to the terminal, deliberately: a credential written to a
# file is a credential that outlives the conversation it was needed for.
# Redirecting the output to a file is still the obvious thing to do when nine
# of them have to be sent to nine different people, so the obvious filenames
# are ignored rather than left as a trap.
#
# Ignoring them is the floor, not the fix, AND THE REASON GOT WORSE on
# 9 October 2026. These accounts used to be forced to replace the printed
# password on first sign-in, so a stale file held dead credentials. Nothing
# forces a change now, so every line in such a file is a WORKING credential to
# an account that reads patient names, for as long as the account exists.
#
# Delete the file as soon as the passwords are sent. If one is lost or leaks,
# the fix is a reset -- the contract manager can do their own eight counters
# from the portal, or re-run the script with --reset -- not a hope that it
# expired, because it does not.
portals.txt
leads.txt
credentials.txt
*-credentials.txt

# Generated mock lists. The generator is in server/scripts/mock-list.mjs and
# is deterministic, so the file can always be remade; a binary spreadsheet of
# invented patients does not belong in the history.
docs/forms/mock-list-*.xlsx
docs/forms/mock-list-*.csv

# Signing keys. Never. The upload key is the app: in a public repository it
# is a key anyone can sign a build with.
*.jks
*.keystore
!app/android/app/debug.keystore

# Address lists for set-emails.mjs. THIS REPOSITORY IS PUBLIC.
# A `username,email` file is a staff directory: real mailboxes for couriers
# and for University Health pharmacy staff. It is also the file that decides
# where a password reset code is sent, so it is worth exactly as much to
# somebody else as it is to us. Keep it on the machine that runs the script.
emails.csv
*.emails.csv

# One-off credential tooling and its output. Public repository.
reset-uh-portals.py
*.docx

# One-off production tooling.
purge-drivers.ps1
stage-wheatley.ps1
list-drivers.mjs

# The driver roster for create-drivers.mjs and load-roster.mjs. SAME REASON
# AS emails.csv ABOVE, and this one is worse: `username,name,email,site` is
# twenty-three real people, their mailboxes, and which University Health
# counter each of them drives from every weekday. That is a staff directory
# and a rota in one file. It stays on the machine that runs the script.
drivers.csv
*.drivers.csv
roster.csv

# The never-delete list for courier-inventory.mjs. Same reason as the files
# above: a driver's username is their personal email address.
protected.txt

# Training captures and the video built from them. THIS REPOSITORY IS PUBLIC.
#
# portal-screens/m3-roster.png is the driver roster screen, which is
# twenty-three real people, their usernames and which University Health
# counter each one drives from -- the same staff directory the roster.csv
# rule above exists for, in an image rather than a CSV. m6-drivers.png and
# m2-board.png carry names too, and portal-training.mp4 has all of them on
# slides. The gitignore above protects the files; it cannot protect a
# screenshot of what those files produced.
#
# The video and the screens are deliverables for University Health staff and
# are handed over directly. The written material beside them -- the script,
# the reset instructions, the READMEs -- carries no names and is committed.
docs/training/portal-screens/*.png
docs/training/portal-training.mp4
retire.txt

# Python bytecode from server/scripts.
__pycache__/
