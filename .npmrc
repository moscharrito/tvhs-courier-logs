# Build dependencies are dependencies.
#
# Render (and most PaaS) set NODE_ENV=production, which makes npm derive
# omit=dev and skip devDependencies. Everything that builds this repo lives
# there: typescript, vite, vitest, the jest-dom types. The 2026-09-21 deploy
# failed on exactly that, and the error it produced pointed somewhere else
# entirely -- "Option 'moduleResolution=node10' has been removed" -- because
# with typescript absent, `tsc` resolved to a newer compiler already present
# on the build image.
#
# `include` beats `omit` in npm regardless of order or NODE_ENV, so this one
# line holds whether the service is built from render.yaml or from a build
# command typed into a dashboard. That is why it is here and not only there.
include=dev
