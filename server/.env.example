# Copy to server/.env (gitignored). On Render, set these in the service's Environment tab.

# Operating timezone for check-in dates/times
APP_TIMEZONE=America/Chicago

# Keeps sessions valid across restarts/deploys (generate a long random string)
SESSION_SECRET=change-me

# Turso (libSQL) database for production persistence.
# Leave unset locally to use a local SQLite file (server/courier_logs.db).
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Admin
ADMIN_USER=admin
ADMIN_PASS=change-me

# Driver 1 (SouthBound)
DRIVER1_USER=driver1
DRIVER1_PASS=change-me

# Driver 2 (NorthBound)
DRIVER2_USER=driver2
DRIVER2_PASS=change-me

# Runtime environment: development (default), test, or production.
# In production TURSO_DATABASE_URL is required and SESSION_SECRET must be 32+ chars.
# NODE_ENV=development

# Local SQLite file, relative to server/, used when TURSO_DATABASE_URL is unset.
# DB_FILE=courier_logs.db

# Proof-of-delivery file storage (ticket 1.8). When FILES_ENABLED=true all four
# S3 values are required. Use a bucket covered by a signed AWS BAA.
# FILES_ENABLED=false
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_KMS_KEY_ID=
