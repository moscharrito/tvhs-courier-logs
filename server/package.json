{
  "name": "@izy/server",
  "version": "1.0.0",
  "private": true,
  "description": "Izy Ops Platform API server (TVHS courier logs, UH pharmacy courier dispatch)",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "bcryptjs": "^3.0.3",
    "cookie-session": "^2.1.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "supertest": "^7.2.2",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
